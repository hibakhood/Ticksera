# ─── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Resend (transactional emails) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx

# ─── Paystack (payments) ──────────────────────────────────────────────────────
# Test key: sk_test_xxxx, live key: sk_live_xxxx (from dashboard.paystack.com).
# Leave empty to disable checkout (Billing shows "payments not configured").
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# Webhook secret from Dashboard → Settings → Webhooks. Required for /api/paystack/webhook.
PAYSTACK_WEBHOOK_SECRET=
# Used by /api/paystack/verify to write the confirmed payment into Supabase.
# Keep in sync with SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://your-project.supabase.co

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5000

# Comma-separated emails that are always treated as super_admin (bootstrap admin)
VITE_SUPER_ADMIN_EMAIL=
# Server-side mirror of VITE_SUPER_ADMIN_EMAIL, used by /api/state and /api/agent
# to authorize staff/gateway access without a DB round-trip. Keep in sync.
SUPER_ADMIN_EMAILS=

# ─── AI Agent (Vercel function /api/agent) ───────────────────────────────────
# OpenAI-compatible endpoint. Qwen3 works via OpenRouter (qwen/qwen3-32b).
# Leave AI_API_KEY empty to keep the rule-based bot fallback.
AI_API_KEY=sk-or-xxxxxxxx
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen3-32b
# Optional per-user AI budget per day (default 60). Over budget → deterministic bot.
AI_DAILY_LIMIT_PER_USER=60
