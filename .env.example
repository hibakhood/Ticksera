# ─── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Resend (transactional emails) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5000

# Comma-separated emails that are always treated as super_admin (bootstrap admin)
VITE_SUPER_ADMIN_EMAIL=

# ─── AI Agent (Vercel function /api/agent) ───────────────────────────────────
# OpenAI-compatible endpoint. Qwen3 works via OpenRouter (qwen/qwen3-32b).
# Leave AI_API_KEY empty to keep the rule-based bot fallback.
AI_API_KEY=sk-or-xxxxxxxx
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen3-32b
